# VeriMark browser configuration. Copy to .env.local (never commit it).
#
# Leave both values empty to run the local demonstration: an in-memory adapter with fictional data and no backend.
# Set both to use a Supabase project that has supabase/migrations applied (see docs/database/SCHEMA-AND-OPERATIONS.md).
#
# Public Supabase project URL, e.g. https://<project-ref>.supabase.co
VITE_SUPABASE_URL=
# Publishable (anon) key. It is public by design; access is enforced by the database.
VITE_SUPABASE_PUBLISHABLE_KEY=
#
# Never put a service-role/secret key, database password or SMTP credential in any VITE_ variable:
# everything prefixed VITE_ is shipped to every visitor's browser. This application needs no server-side secret.
